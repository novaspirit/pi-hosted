{
  "categories": [
    "Books",
    "Media",
    "Tools"
  ],
  "description": "BookBridge synchronises reading progress between Audiobookshelf, Kavita, KOReader, BookFusion and other supported platforms. Configure integrations through the BookBridge web interface after installation.",
  "env": [
    {
      "default": "Europe/London",
      "description": "Container timezone.",
      "label": "TZ",
      "name": "TZ"
    },
    {
      "default": "INFO",
      "description": "Logging level (DEBUG, INFO, WARNING, ERROR).",
      "label": "LOG_LEVEL",
      "name": "LOG_LEVEL"
    },
    {
      "default": "",
      "description": "Optional custom secret key used for credential encryption.",
      "label": "BOOKBRIDGE_SECRET_KEY",
      "name": "BOOKBRIDGE_SECRET_KEY"
    },
    {
      "default": "",
      "description": "Optional dedicated KoSync port. Set to 5758 to enable split-port mode.",
      "label": "KOSYNC_PORT",
      "name": "KOSYNC_PORT"
    }
  ],
  "image_arm64": "ghcr.io/cporcellijr/bookbridge:latest",
  "image_amd64": "ghcr.io/cporcellijr/bookbridge:latest",
  "logo": "https://raw.githubusercontent.com/cporcellijr/bookbridge/main/static/img/bookbridge-logo.png",
  "name": "bookbridge",
  "officialDoc": "https://cporcellijr.github.io/bookbridge/",
  "platform": "linux",
  "ports": [
    "8086:5757/tcp"
  ],
  "restart_policy": "unless-stopped",
  "title": "BookBridge",
  "type": 1,
  "volumes": [
    {
      "container": "/data",
      "host": "/portainer/Files/AppData/Config/BookBridge"
    },
    {
      "container": "/books",
      "host": "/portainer/Files/Books"
    },
    {
      "container": "/audiobooks",
      "host": "/portainer/Files/AudioBooks"
    }
  ],
  "webpage": "https://github.com/cporcellijr/bookbridge"
}
